0000              cstart:
; ---- start with high impedance
0000    5             hiz

; ---- set interrupt transfer interval
0001    f d           load 13
0003    0
0004              cstart2:
0004    e             wait
0005    9 1 4 6       bc connected
0009    9 0 1 0       be cstart2

; ---- wait 200ms after device attached
000d    c f 0         save 15 0             ; disconnected, reset watchdog
0010    1 8 c         ldi 200
0013    0
0014              w200ms:
0014    e             wait
0015    b             dec
0016    9 4 5 0       bnz w200ms

; ---- enumeration sequence
001a    8 d 6         call reset            ; reset device

; GET_DESCRIPTOR (Device, 0)
001d    e             wait
001e    8 7 f         call sof
0021    8 8 d         call setup00
0024    8 5 7         call get_device
0027    8 4 d         call rcvdt
002a    1 0 8         ldi 128               ; receive 16 bytes of data from device
002d    2             start                 ; mark start of read transaction

; IN(0,0), ACK(), device descriptor
002e    0 0
0030              wait_get_device:
0030    e             wait
0031    8 7 f         call sof
0034    8 6 e         call in00
0037    8 5 d         call rcvdt2
003a    9 2 c 0       bnak wait_get_device
003e    8 4 f         call sendack
0041    9 4 c 0       bnz wait_get_device
; the buffer wraps, start reading from byte 8
0045    c 0 0         save 0 0              ; idVendor lsb
0048    c 1 1         save 1 1              ; idVendor msb
004b    c 2 2         save 2 2              ; idProduct lsb
004e    c 3 3         save 3 3              ; idProduct msb

; GET_DESCRIPTOR (Configuration, 0)
0051    e             wait
0052    8 7 f         call sof
0055    8 8 d         call setup00
0058    8 0 8         call get_config
005b    8 4 d         call rcvdt
005e    1 0 9         ldi 144               ; receive up to 18 bytes of data from device
0061    2             start                 ; mark start of read transaction

; IN(0,0), ACK(), configuration descriptor
0062    0 0
0064              wait_get_config:
0064    e             wait
0065    8 7 f         call sof
0068    8 6 e         call in00
006b    8 5 d         call rcvdt2
006e    9 2 9 1       bnak wait_get_config
0072    8 4 f         call sendack
0075    9 4 9 1       bnz wait_get_config
; the buffer wraps, start reading from byte 14
0079    c 4 6         save 4 6               ; interface class
007c    c 5 7         save 5 7               ; interface sub-class
007f    c 6 0         save 6 0               ; interface protocol

; ---- initialization sequence
0082    8 d 6         call reset            ; reset device again

; SET_ADDRESS (0, 1)
0085    e             wait
0086    8 7 f         call sof
0089    8 8 d         call setup00
008c    8 b 8         call set_address
008f    8 4 d         call rcvdt

; IN(0,0), ACK()
0092    0 0
0094              wait_set_address:
0094    e             wait
0095    8 7 f         call sof
0098    8 6 e         call in00
009b    8 4 d         call rcvdt
009e    9 2 5 2       bnak wait_set_address
00a2    8 4 f         call sendack

; SET_CONFIGURATION (1, 1)
00a5    e             wait
00a6    8 7 f         call sof
00a9    8 d d         call setup10
00ac    8 6 9         call set_config
00af    8 4 d         call rcvdt

; IN(1,0), ACK()
00b2    0 0
00b4              wait_set_config:
00b4    e             wait
00b5    8 7 f         call sof
00b8    8 b e         call in10
00bb    8 4 d         call rcvdt
00be    9 2 d 2       bnak wait_set_config
00c2    8 4 f         call sendack

; skip HID initialization for Xbox 360-compatbile controllers
00c5    f c           load 12
00c7    9 4 3 5       bnz xinput_init

; SET_IDLE (1, 0)
00cb    e             wait
00cc    8 7 f         call sof
00cf    8 d d         call setup10
00d2    8 1 a         call set_idle
00d5    8 4 d         call rcvdt

; IN(1,0), ACK()
00d8              wait_set_idle:
00d8    e             wait
00d9    8 7 f         call sof
00dc    8 b e         call in10
00df    8 4 d         call rcvdt
00e2    9 3 c 3       bstall set_idle_ready
00e6    9 2 6 3       bnak wait_set_idle
00ea    8 4 f         call sendack
00ed    0 0 0
00f0              set_idle_ready:

; GET_DESCRIPTOR (HID, 1, 0)
00f0    e             wait
00f1    8 7 f         call sof
00f4    8 d d         call setup10
00f7    8 7 b         call get_hid_report
00fa    8 4 d         call rcvdt
00fd    1 8 4         ldi 72                ; receive 9 bytes of data from device
0100    2             start                 ; mark start of read transaction

; IN(1,0), ACK() - read but ignore contents
0101    0 0 0
0104              wait_get_hid_report:
0104    e             wait
0105    8 7 f         call sof
0108    8 b e         call in10
010b    8 5 d         call rcvdt2
010e    9 3 8 4       bstall get_hid_report_ready
0112    9 2 1 4       bnak wait_get_hid_report
0116    8 4 f         call sendack
0119    9 4 1 4       bnz wait_get_hid_report
011d    0 0 0
0120              get_hid_report_ready:

; SET_PROTOCOL (1, 0)
0120    e             wait
0121    8 7 f         call sof
0124    8 d d         call setup10
0127    8 c a         call set_protocol
012a    8 4 d         call rcvdt

; IN(1,0), ACK()
012d    0 0 0
0130              wait_set_protocol:
0130    e             wait
0131    8 7 f         call sof
0134    8 b e         call in10
0137    8 4 d         call rcvdt
013a    9 3 2 5       bstall set_protocol_ready
013e    9 2 c 4       bnak wait_set_protocol
0142    8 4 f         call sendack
0145    0 0 0
0148              set_protocol_ready:
0148    9 7 2 6       bjmp init_finished

014c              xinput_init:
; huge thanks to Jakob
; ref: https://jakob.space/blog/sorry-guys-i-have-to-troubleshoot-my-usb-drivers-before-i-can-play.html
; XINPUT_LED (1)
014c    e             wait
014d    8 7 f         call sof
0150    8 2 e         call out1x
0153    8 2 c         call xinput_led
0156    8 4 d         call rcvdt

; some third-party controllers Xbox 360-style controllers
; require this message to finish initialization
; ref: linux/drivers/input/joystick/xpad.c
; XINPUT_INIT (1)
0159    e             wait
015a    8 7 f         call sof
015d    8 d d         call setup10
0160    8 9 c         call xinput_magic
0163    8 4 d         call rcvdt
0166    1 0 a         ldi 160               ; receive 20 bytes of data from device
0169    2             start                 ; mark start of read transaction

; IN(1,0), ACK() - read but ignore contents
016a    0 0
016c              wait_xinput_magic:
016c    e             wait
016d    8 7 f         call sof
0170    8 b e         call in10
0173    8 5 d         call rcvdt2
0176    9 3 2 6       bstall xinput_magic_ready
017a    9 2 b 5       bnak wait_xinput_magic
017e    8 4 f         call sendack
0181    9 4 b 5       bnz wait_xinput_magic
0185    0 0 0
0188              xinput_magic_ready:

; ---- initialization finished
0188              init_finished:
0188    c f 1         save 15 1             ; connected
018b    9 7 0 0       bjmp cstart

; ---- interrupt polling
018f    0
0190              connected:
0190    8 7 f         call sof
0193    b             dec
0194    9 4 1 0       bnz cstart2
0198    2             start                 ; mark start of read transaction
0199    8 0 f         call in1x
019c    8 4 d         call rcvdt
019f    9 2 0 0       bnak cstart
01a3    8 4 f         call sendack
01a6    9 7 0 0       bjmp cstart

; ---- disconnect and jump start
01aa    0 0
01ac              connerr:
01ac    c f 0         save 15 0             ; disconnected
01af    9 7 0 0       bjmp cstart

; ---- subroutines
01b3    0
01b4              reset:
01b4    3 0 0         out4 0x00

; ---- wait 20ms
01b7    1 4 1         ldi 20
01ba    0 0
01bc              loop_reset:
01bc    e             wait
01bd    b             dec
01be    9 4 f 6       bnz loop_reset
01c2    5             hiz

; ---- wait 40ms
01c3    1 8 2         ldi 40
01c6    0 0
01c8              w40ms:
01c8    e             wait
01c9    8 7 f         call sof
01cc    b             dec
01cd    9 4 2 7       bnz w40ms
01d1    7             ret

01d2    0 0
01d4              get_device:               ; get device descriptor of (0,0)  get device descriptor of (0,0)
01d4    6 0 8         outb 0x80             ; SYNC
01d7    6 3 c         outb 0xc3             ; PID=DATA0
01da    6 0 8         outb 0x80             ; bmRequestType=80
01dd    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
01e0    6 0 0         outb 0x00             ; Desc Index=0
01e3    6 1 0         outb 0x01             ; Desc Type=1 (device)
01e6    6 0 0         outb 0x00             ; Language ID=0
01e9    6 0 0         outb 0x00             ;
01ec    6 0 1         outb 0x10             ; wLength=16
01ef    6 0 0         outb 0x00
01f2    6 1 e         outb 0xe1             ; CRC16
01f5    6 4 9         outb 0x94
01f8    3 3 0         out4 0x03             ; EOP
01fb    5             hiz
01fc    7             ret

01fd    0 0 0
0200              get_config:               ; get config descriptor of (0,0)  get config descriptor of (0,0)
0200    6 0 8         outb 0x80             ; SYNC
0203    6 3 c         outb 0xc3             ; PID=DATA0
0206    6 0 8         outb 0x80             ; bmRequestType=0
0209    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
020c    6 0 0         outb 0x00             ; Desc Index=0
020f    6 2 0         outb 0x02             ; Desc Type=2 (configuration)
0212    6 0 0         outb 0x00             ; Language ID=0
0215    6 0 0         outb 0x00             ;
0218    6 2 1         outb 0x12             ; wLength=18
021b    6 0 0         outb 0x00
021e    6 4 a         outb 0xa4             ; CRC16
0221    6 4 f         outb 0xf4
0224    3 3 0         out4 0x03             ; EOP
0227    5             hiz
0228    7             ret

0229    0 0 0
022c              set_address:              ; set address of device 0 to 1  set address of device 0 to 1
022c    6 0 8         outb 0x80
022f    6 3 c         outb 0xc3
0232    6 0 0         outb 0x00
0235    6 5 0         outb 0x05
0238    6 1 0         outb 0x01
023b    6 0 0         outb 0x00
023e    6 0 0         outb 0x00
0241    6 0 0         outb 0x00
0244    6 0 0         outb 0x00
0247    6 0 0         outb 0x00
024a    6 b e         outb 0xeb
024d    6 5 2         outb 0x25
0250    3 3 0         out4 0x03
0253    5             hiz
0254    7             ret

0255    0 0 0
0258              set_config:               ; set active configuration of device 1 to 1 (default config)  set active configuration of device 1 to 1 (default config)
0258    6 0 8         outb 0x80
025b    6 3 c         outb 0xc3
025e    6 0 0         outb 0x00
0261    6 9 0         outb 0x09
0264    6 1 0         outb 0x01
0267    6 0 0         outb 0x00
026a    6 0 0         outb 0x00
026d    6 0 0         outb 0x00
0270    6 0 0         outb 0x00
0273    6 0 0         outb 0x00
0276    6 7 2         outb 0x27
0279    6 5 2         outb 0x25
027c    3 3 0         out4 0x03
027f    5             hiz
0280    7             ret

0281    0 0 0
0284              set_idle:
0284    6 0 8         outb 0x80             ; SYNC
0287    6 3 c         outb 0xc3             ; PID=DATA0
028a    6 1 2         outb 0x21             ; bmRequestType=21
028d    6 a 0         outb 0x0a             ; bRequest=a (Set_Idle)
0290    6 0 0         outb 0x00             ; wValue=0
0293    6 0 0         outb 0x00
0296    6 0 0         outb 0x00             ; wIndex=0
0299    6 0 0         outb 0x00
029c    6 0 0         outb 0x00             ; wLength=0
029f    6 0 0         outb 0x00
02a2    6 6 d         outb 0xd6             ; CRC16
02a5    6 0 2         outb 0x20
02a8    3 3 0         out4 0x03             ; EOP
02ab    5             hiz
02ac    7             ret

02ad    0 0 0
02b0              set_protocol:
02b0    6 0 8         outb 0x80             ; SYNC
02b3    6 3 c         outb 0xc3             ; PID=DATA0
02b6    6 1 2         outb 0x21             ; bmRequestType=21
02b9    6 b 0         outb 0x0b             ; bRequest=b (Set_Protocol)
02bc    6 0 0         outb 0x00             ; wValue=0
02bf    6 0 0         outb 0x00
02c2    6 0 0         outb 0x00             ; wIndex=0
02c5    6 0 0         outb 0x00
02c8    6 0 0         outb 0x00             ; wLength=0
02cb    6 0 0         outb 0x00
02ce    6 6 c         outb 0xc6             ; CRC16
02d1    6 0 e         outb 0xe0
02d4    3 3 0         out4 0x03             ; EOP
02d7    5             hiz
02d8    7             ret

02d9    0 0 0
02dc              get_hid_report:
02dc    6 0 8         outb 0x80             ; SYNC
02df    6 3 c         outb 0xc3             ; PID=DATA0
02e2    6 1 8         outb 0x81             ; bmRequestType=81
02e5    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
02e8    6 0 0         outb 0x00             ; Desc Index=0
02eb    6 2 2         outb 0x22             ; Desc Type=22 HID
02ee    6 0 0         outb 0x00             ; wInterfaceNumber=0
02f1    6 0 0         outb 0x00
02f4    6 9 0         outb 0x09             ; wLength=9
02f7    6 0 0         outb 0x00
02fa    6 e e         outb 0xee             ; CRC16
02fd    6 f 0         outb 0x0f
0300    3 3 0         out4 0x03             ; EOP
0303    5             hiz
0304    7             ret

0305    0 0 0
0308              xinput_led:
0308    6 0 8         outb 0x80             ; SYNC
030b    6 3 c         outb 0xc3             ; PID=DATA0
030e    6 1 0         outb 0x01
0311    6 3 0         outb 0x03
0314    6 2 0         outb 0x02
0317    6 e 5         outb 0x5e             ; CRC16
031a    6 e c         outb 0xce
031d    3 3 0         out4 0x03             ; EOP
0320    5             hiz
0321    7             ret

0322    0 0
0324              xinput_magic:
0324    6 0 8         outb 0x80             ; SYNC
0327    6 3 c         outb 0xc3             ; PID=DATA0
032a    6 1 c         outb 0xc1             ; bmRequestType=c1
032d    6 1 0         outb 0x01             ; bRequest=1
0330    6 0 0         outb 0x00             ; wValue=0x0100
0333    6 1 0         outb 0x01
0336    6 0 0         outb 0x00             ; wIndex=0x0000
0339    6 0 0         outb 0x00
033c    6 4 1         outb 0x14             ; wLength=20
033f    6 0 0         outb 0x00
0342    6 0 5         outb 0x50             ; CRC16
0345    6 8 6         outb 0x68
0348    3 3 0         out4 0x03             ; EOP
034b    5             hiz
034c    7             ret

034d    0 0 0
0350              rcvdt:
0350    1 0 4         ldi 64                ; receive up to 8 bytes of data from device by default
0353    0
0354              rcvdt2:
0354    d             in
0355    0 0 0
0358              rcvdt_eop:
0358    5             hiz
0359    9 0 6 d       be rcvdt_eop          ; wait for line idle
035d    5             hiz                   ; ensure delay before next transaction
035e    7             ret

035f    0
0360              setup00:
0360    6 0 8         outb 0x80             ; SYNC
0363    6 d 2         outb 0x2d             ; PID
0366    6 0 0         outb 0x00             ; ADDR:ENDP=0:0
0369    6 0 1         outb 0x10             ; + CRC5
036c    3 3 0         out4 0x03             ; EOP
036f    5             hiz
0370    7             ret

0371    0 0 0
0374              setup10:
0374    6 0 8         outb 0x80             ; SYNC
0377    6 d 2         outb 0x2d             ; PID
037a    6 1 0         outb 0x01             ; ADDR:ENDP=1:0
037d    6 8 e         outb 0xe8             ; + CRC5
0380    3 3 0         out4 0x03             ; EOP
0383    5             hiz
0384    7             ret

0385    0 0 0
0388              out1x:
0388    6 0 8         outb 0x80             ; SYNC
038b    6 1 e         outb 0xe1             ; PID=OUT
038e    a a           outr 10               ; ADDR:ENDP
0390    a b           outr 11               ; + CRC5
0392    3 3 0         out4 0x03             ; EOP
0395    5             hiz
0396    7             ret

0397    0
0398              in00:
0398    6 0 8         outb 0x80             ; SYNC
039b    6 9 6         outb 0x69             ; PID=IN
039e    6 0 0         outb 0x00             ; ADDR:ENDP=0:0
03a1    6 0 1         outb 0x10             ; + CRC5
03a4    3 3 0         out4 0x03             ; EOP
03a7    5             hiz
03a8    7             ret

03a9    0 0 0
03ac              in10:
03ac    6 0 8         outb 0x80             ; SYNC
03af    6 9 6         outb 0x69             ; PID=IN
03b2    6 1 0         outb 0x01             ; ADDR:ENDP=1:0
03b5    6 8 e         outb 0xe8             ; + CRC5
03b8    3 3 0         out4 0x03             ; EOP
03bb    5             hiz
03bc    7             ret

03bd    0 0 0
03c0              in1x:
03c0    6 0 8         outb 0x80             ; SYNC
03c3    6 9 6         outb 0x69             ; PID=IN
03c6    a 8           outr 8                ; ADDR:ENDP
03c8    a 9           outr 9                ; + CRC5
03ca    3 3 0         out4 0x03             ; EOP
03cd    5             hiz
03ce    7             ret

03cf    0
03d0              sendack:
03d0    6 0 8         outb 0x80
03d3    6 2 d         outb 0xd2
03d6    3 3 0         out4 0x03
03d9    5             hiz
03da    7             ret

03db    0
03dc              sof:
03dc    9 0 b 6       be connerr
03e0    9 6 c f       bnf keep_alive
03e4    6 0 8         outb 0x80
03e7    6 5 a         outb 0xa5
03ea    6 0 0         outb 0x00
03ed    6 0 1         outb 0x10
03f0              keep_alive:
03f0    3 3 0         out4 0x03             ; low-speed keep-alive
03f3    5             hiz
03f4    7             ret

03f5    0 0 0
03f8              prgend:
