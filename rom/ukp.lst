0000              cstart:
; ---- start with high impedance
0000    5             hiz

; ---- set interrupt transfer interval
0001    f d           load 13
0003    0
0004              cstart2:
0004    e             wait
0005    9 1 4 6       bc connected
0009    9 0 1 0       be cstart2

; ---- wait 200ms after device attached
000d    c f 0         save 15 0             ; disconnected, reset watchdog
0010    1 8 c         ldi 200
0013    0
0014              w200ms:
0014    e             wait
0015    b             dec
0016    9 4 5 0       bnz w200ms

; ---- enumeration sequence
001a    8 e 6         call reset            ; reset device

; GET_DESCRIPTOR (Device, 0)
001d    e             wait
001e    8 8 f         call sof
0021    8 9 d         call setup00
0024    8 6 7         call get_device
0027    8 5 d         call rcvdt
002a    1 0 8         ldi 128               ; receive 16 bytes of data from device
002d    2             start                 ; mark start of read transaction

; IN(0,0), ACK(), device descriptor
002e    0 0
0030              wait_get_device:
0030    e             wait
0031    8 8 f         call sof
0034    8 7 e         call in00
0037    8 6 d         call rcvdt2
003a    9 2 c 0       bnak wait_get_device
003e    8 5 f         call sendack
0041    9 4 c 0       bnz wait_get_device
; start reading from byte 8
0045    c 0 8         save 0 8              ; idVendor lsb
0048    c 1 9         save 1 9              ; idVendor msb
004b    c 2 a         save 2 10             ; idProduct lsb
004e    c 3 b         save 3 11             ; idProduct msb

; GET_DESCRIPTOR (Configuration, 0)
0051    e             wait
0052    8 8 f         call sof
0055    8 9 d         call setup00
0058    8 1 8         call get_config
005b    8 5 d         call rcvdt
005e    1 0 9         ldi 144               ; receive up to 18 bytes of data from device
0061    2             start                 ; mark start of read transaction

; IN(0,0), ACK(), configuration descriptor
0062    0 0
0064              wait_get_config:
0064    e             wait
0065    8 8 f         call sof
0068    8 7 e         call in00
006b    8 6 d         call rcvdt2
006e    9 2 9 1       bnak wait_get_config
0072    8 5 f         call sendack
0075    9 4 9 1       bnz wait_get_config
; start reading from byte 14
0079    c 4 e         save 4 14               ; interface class
007c    c 5 f         save 5 15               ; interface sub-class
; buffer wraps here
007f    c 6 0         save 6 0                ; interface protocol

; ---- initialization sequence
0082    8 e 6         call reset            ; reset device again

; SET_ADDRESS (0, 1)
0085    e             wait
0086    8 8 f         call sof
0089    8 9 d         call setup00
008c    8 c 8         call set_address
008f    8 5 d         call rcvdt

; IN(0,0), ACK()
0092    0 0
0094              wait_set_address:
0094    e             wait
0095    8 8 f         call sof
0098    8 7 e         call in00
009b    8 5 d         call rcvdt
009e    9 2 5 2       bnak wait_set_address
00a2    8 5 f         call sendack

; SET_CONFIGURATION (1, 1)
00a5    e             wait
00a6    8 8 f         call sof
00a9    8 e d         call setup10
00ac    8 7 9         call set_config
00af    8 5 d         call rcvdt

; IN(1,0), ACK()
00b2    0 0
00b4              wait_set_config:
00b4    e             wait
00b5    8 8 f         call sof
00b8    8 c e         call in10
00bb    8 5 d         call rcvdt
00be    9 2 d 2       bnak wait_set_config
00c2    8 5 f         call sendack

; skip HID initialization for Xbox 360-compatbile controllers
00c5    f c           load 12
00c7    9 4 3 5       bnz xinput_init

; SET_IDLE (1, 0)
00cb    e             wait
00cc    8 8 f         call sof
00cf    8 e d         call setup10
00d2    8 2 a         call set_idle
00d5    8 5 d         call rcvdt

; IN(1,0), ACK()
00d8              wait_set_idle:
00d8    e             wait
00d9    8 8 f         call sof
00dc    8 c e         call in10
00df    8 5 d         call rcvdt
00e2    9 3 c 3       bstall set_idle_ready
00e6    9 2 6 3       bnak wait_set_idle
00ea    8 5 f         call sendack
00ed    0 0 0
00f0              set_idle_ready:

; GET_DESCRIPTOR (HID, 1, 0)
00f0    e             wait
00f1    8 8 f         call sof
00f4    8 e d         call setup10
00f7    8 8 b         call get_hid_report
00fa    8 5 d         call rcvdt
00fd    1 8 4         ldi 72                ; receive 9 bytes of data from device
0100    2             start                 ; mark start of read transaction

; IN(1,0), ACK() - read but ignore contents
0101    0 0 0
0104              wait_get_hid_report:
0104    e             wait
0105    8 8 f         call sof
0108    8 c e         call in10
010b    8 6 d         call rcvdt2
010e    9 3 8 4       bstall get_hid_report_ready
0112    9 2 1 4       bnak wait_get_hid_report
0116    8 5 f         call sendack
0119    9 4 1 4       bnz wait_get_hid_report
011d    0 0 0
0120              get_hid_report_ready:

; SET_PROTOCOL (1, 0)
0120    e             wait
0121    8 8 f         call sof
0124    8 e d         call setup10
0127    8 d a         call set_protocol
012a    8 5 d         call rcvdt

; IN(1,0), ACK()
012d    0 0 0
0130              wait_set_protocol:
0130    e             wait
0131    8 8 f         call sof
0134    8 c e         call in10
0137    8 5 d         call rcvdt
013a    9 3 2 5       bstall set_protocol_ready
013e    9 2 c 4       bnak wait_set_protocol
0142    8 5 f         call sendack
0145    0 0 0
0148              set_protocol_ready:
0148    9 7 2 6       bjmp init_finished

014c              xinput_init:
; huge thanks to Jakob
; ref: https://jakob.space/blog/sorry-guys-i-have-to-troubleshoot-my-usb-drivers-before-i-can-play.html
; XINPUT_LED (1)
014c    e             wait
014d    8 8 f         call sof
0150    8 3 e         call out1x
0153    8 3 c         call xinput_led
0156    8 5 d         call rcvdt

; some third-party controllers Xbox 360-style controllers
; require this message to finish initialization
; ref: linux/drivers/input/joystick/xpad.c
; XINPUT_INIT (1)
0159    e             wait
015a    8 8 f         call sof
015d    8 e d         call setup10
0160    8 a c         call xinput_magic
0163    8 5 d         call rcvdt
0166    1 0 a         ldi 160               ; receive 20 bytes of data from device
0169    2             start                 ; mark start of read transaction

; IN(1,0), ACK() - read but ignore contents
016a    0 0
016c              wait_xinput_magic:
016c    e             wait
016d    8 8 f         call sof
0170    8 c e         call in10
0173    8 6 d         call rcvdt2
0176    9 3 2 6       bstall xinput_magic_ready
017a    9 2 b 5       bnak wait_xinput_magic
017e    8 5 f         call sendack
0181    9 4 b 5       bnz wait_xinput_magic
0185    0 0 0
0188              xinput_magic_ready:

; ---- initialization finished
0188              init_finished:
0188    c f 1         save 15 1             ; connected
018b    9 7 0 0       bjmp cstart

; ---- interrupt polling
018f    0
0190              connected:
0190    8 8 f         call sof
0193    b             dec
0194    9 4 1 0       bnz cstart2
0198    2             start                 ; mark start of read transaction
0199    8 1 f         call in1x
019c    1 0 8         ldi 128               ; receive up to 16 bytes of HID report
019f    8 6 d         call rcvdt2
01a2    9 2 0 0       bnak cstart
01a6    8 5 f         call sendack
01a9    9 7 0 0       bjmp cstart

; ---- disconnect and jump start
01ad    0 0 0
01b0              connerr:
01b0    c f 0         save 15 0             ; disconnected
01b3    9 7 0 0       bjmp cstart

; ---- subroutines
01b7    0
01b8              reset:
01b8    3 0 0         out4 0x00

; ---- wait 20ms
01bb    1 4 1         ldi 20
01be    0 0
01c0              loop_reset:
01c0    e             wait
01c1    b             dec
01c2    9 4 0 7       bnz loop_reset
01c6    5             hiz

; ---- wait 40ms
01c7    1 8 2         ldi 40
01ca    0 0
01cc              w40ms:
01cc    e             wait
01cd    8 8 f         call sof
01d0    b             dec
01d1    9 4 3 7       bnz w40ms
01d5    7             ret

01d6    0 0
01d8              get_device:               ; get device descriptor of (0,0)  get device descriptor of (0,0)
01d8    6 0 8         outb 0x80             ; SYNC
01db    6 3 c         outb 0xc3             ; PID=DATA0
01de    6 0 8         outb 0x80             ; bmRequestType=80
01e1    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
01e4    6 0 0         outb 0x00             ; Desc Index=0
01e7    6 1 0         outb 0x01             ; Desc Type=1 (device)
01ea    6 0 0         outb 0x00             ; Language ID=0
01ed    6 0 0         outb 0x00             ;
01f0    6 0 1         outb 0x10             ; wLength=16
01f3    6 0 0         outb 0x00
01f6    6 1 e         outb 0xe1             ; CRC16
01f9    6 4 9         outb 0x94
01fc    3 3 0         out4 0x03             ; EOP
01ff    5             hiz
0200    7             ret

0201    0 0 0
0204              get_config:               ; get config descriptor of (0,0)  get config descriptor of (0,0)
0204    6 0 8         outb 0x80             ; SYNC
0207    6 3 c         outb 0xc3             ; PID=DATA0
020a    6 0 8         outb 0x80             ; bmRequestType=0
020d    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
0210    6 0 0         outb 0x00             ; Desc Index=0
0213    6 2 0         outb 0x02             ; Desc Type=2 (configuration)
0216    6 0 0         outb 0x00             ; Language ID=0
0219    6 0 0         outb 0x00             ;
021c    6 2 1         outb 0x12             ; wLength=18
021f    6 0 0         outb 0x00
0222    6 4 a         outb 0xa4             ; CRC16
0225    6 4 f         outb 0xf4
0228    3 3 0         out4 0x03             ; EOP
022b    5             hiz
022c    7             ret

022d    0 0 0
0230              set_address:              ; set address of device 0 to 1  set address of device 0 to 1
0230    6 0 8         outb 0x80
0233    6 3 c         outb 0xc3
0236    6 0 0         outb 0x00
0239    6 5 0         outb 0x05
023c    6 1 0         outb 0x01
023f    6 0 0         outb 0x00
0242    6 0 0         outb 0x00
0245    6 0 0         outb 0x00
0248    6 0 0         outb 0x00
024b    6 0 0         outb 0x00
024e    6 b e         outb 0xeb
0251    6 5 2         outb 0x25
0254    3 3 0         out4 0x03
0257    5             hiz
0258    7             ret

0259    0 0 0
025c              set_config:               ; set active configuration of device 1 to 1 (default config)  set active configuration of device 1 to 1 (default config)
025c    6 0 8         outb 0x80
025f    6 3 c         outb 0xc3
0262    6 0 0         outb 0x00
0265    6 9 0         outb 0x09
0268    6 1 0         outb 0x01
026b    6 0 0         outb 0x00
026e    6 0 0         outb 0x00
0271    6 0 0         outb 0x00
0274    6 0 0         outb 0x00
0277    6 0 0         outb 0x00
027a    6 7 2         outb 0x27
027d    6 5 2         outb 0x25
0280    3 3 0         out4 0x03
0283    5             hiz
0284    7             ret

0285    0 0 0
0288              set_idle:
0288    6 0 8         outb 0x80             ; SYNC
028b    6 3 c         outb 0xc3             ; PID=DATA0
028e    6 1 2         outb 0x21             ; bmRequestType=21
0291    6 a 0         outb 0x0a             ; bRequest=a (Set_Idle)
0294    6 0 0         outb 0x00             ; wValue=0
0297    6 0 0         outb 0x00
029a    6 0 0         outb 0x00             ; wIndex=0
029d    6 0 0         outb 0x00
02a0    6 0 0         outb 0x00             ; wLength=0
02a3    6 0 0         outb 0x00
02a6    6 6 d         outb 0xd6             ; CRC16
02a9    6 0 2         outb 0x20
02ac    3 3 0         out4 0x03             ; EOP
02af    5             hiz
02b0    7             ret

02b1    0 0 0
02b4              set_protocol:
02b4    6 0 8         outb 0x80             ; SYNC
02b7    6 3 c         outb 0xc3             ; PID=DATA0
02ba    6 1 2         outb 0x21             ; bmRequestType=21
02bd    6 b 0         outb 0x0b             ; bRequest=b (Set_Protocol)
02c0    6 0 0         outb 0x00             ; wValue=0
02c3    6 0 0         outb 0x00
02c6    6 0 0         outb 0x00             ; wIndex=0
02c9    6 0 0         outb 0x00
02cc    6 0 0         outb 0x00             ; wLength=0
02cf    6 0 0         outb 0x00
02d2    6 6 c         outb 0xc6             ; CRC16
02d5    6 0 e         outb 0xe0
02d8    3 3 0         out4 0x03             ; EOP
02db    5             hiz
02dc    7             ret

02dd    0 0 0
02e0              get_hid_report:
02e0    6 0 8         outb 0x80             ; SYNC
02e3    6 3 c         outb 0xc3             ; PID=DATA0
02e6    6 1 8         outb 0x81             ; bmRequestType=81
02e9    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
02ec    6 0 0         outb 0x00             ; Desc Index=0
02ef    6 2 2         outb 0x22             ; Desc Type=22 HID
02f2    6 0 0         outb 0x00             ; wInterfaceNumber=0
02f5    6 0 0         outb 0x00
02f8    6 9 0         outb 0x09             ; wLength=9
02fb    6 0 0         outb 0x00
02fe    6 e e         outb 0xee             ; CRC16
0301    6 f 0         outb 0x0f
0304    3 3 0         out4 0x03             ; EOP
0307    5             hiz
0308    7             ret

0309    0 0 0
030c              xinput_led:
030c    6 0 8         outb 0x80             ; SYNC
030f    6 3 c         outb 0xc3             ; PID=DATA0
0312    6 1 0         outb 0x01
0315    6 3 0         outb 0x03
0318    6 2 0         outb 0x02
031b    6 e 5         outb 0x5e             ; CRC16
031e    6 e c         outb 0xce
0321    3 3 0         out4 0x03             ; EOP
0324    5             hiz
0325    7             ret

0326    0 0
0328              xinput_magic:
0328    6 0 8         outb 0x80             ; SYNC
032b    6 3 c         outb 0xc3             ; PID=DATA0
032e    6 1 c         outb 0xc1             ; bmRequestType=c1
0331    6 1 0         outb 0x01             ; bRequest=1
0334    6 0 0         outb 0x00             ; wValue=0x0100
0337    6 1 0         outb 0x01
033a    6 0 0         outb 0x00             ; wIndex=0x0000
033d    6 0 0         outb 0x00
0340    6 4 1         outb 0x14             ; wLength=20
0343    6 0 0         outb 0x00
0346    6 0 5         outb 0x50             ; CRC16
0349    6 8 6         outb 0x68
034c    3 3 0         out4 0x03             ; EOP
034f    5             hiz
0350    7             ret

0351    0 0 0
0354              rcvdt:
0354    1 0 4         ldi 64                ; receive up to 8 bytes of data from device by default
0357    0
0358              rcvdt2:
0358    d             in
0359    0 0 0
035c              rcvdt_eop:
035c    5             hiz
035d    9 0 7 d       be rcvdt_eop          ; wait for line idle
0361    5             hiz                   ; ensure delay before next transaction
0362    7             ret

0363    0
0364              setup00:
0364    6 0 8         outb 0x80             ; SYNC
0367    6 d 2         outb 0x2d             ; PID
036a    6 0 0         outb 0x00             ; ADDR:ENDP=0:0
036d    6 0 1         outb 0x10             ; + CRC5
0370    3 3 0         out4 0x03             ; EOP
0373    5             hiz
0374    7             ret

0375    0 0 0
0378              setup10:
0378    6 0 8         outb 0x80             ; SYNC
037b    6 d 2         outb 0x2d             ; PID
037e    6 1 0         outb 0x01             ; ADDR:ENDP=1:0
0381    6 8 e         outb 0xe8             ; + CRC5
0384    3 3 0         out4 0x03             ; EOP
0387    5             hiz
0388    7             ret

0389    0 0 0
038c              out1x:
038c    6 0 8         outb 0x80             ; SYNC
038f    6 1 e         outb 0xe1             ; PID=OUT
0392    a a           outr 10               ; ADDR:ENDP
0394    a b           outr 11               ; + CRC5
0396    3 3 0         out4 0x03             ; EOP
0399    5             hiz
039a    7             ret

039b    0
039c              in00:
039c    6 0 8         outb 0x80             ; SYNC
039f    6 9 6         outb 0x69             ; PID=IN
03a2    6 0 0         outb 0x00             ; ADDR:ENDP=0:0
03a5    6 0 1         outb 0x10             ; + CRC5
03a8    3 3 0         out4 0x03             ; EOP
03ab    5             hiz
03ac    7             ret

03ad    0 0 0
03b0              in10:
03b0    6 0 8         outb 0x80             ; SYNC
03b3    6 9 6         outb 0x69             ; PID=IN
03b6    6 1 0         outb 0x01             ; ADDR:ENDP=1:0
03b9    6 8 e         outb 0xe8             ; + CRC5
03bc    3 3 0         out4 0x03             ; EOP
03bf    5             hiz
03c0    7             ret

03c1    0 0 0
03c4              in1x:
03c4    6 0 8         outb 0x80             ; SYNC
03c7    6 9 6         outb 0x69             ; PID=IN
03ca    a 8           outr 8                ; ADDR:ENDP
03cc    a 9           outr 9                ; + CRC5
03ce    3 3 0         out4 0x03             ; EOP
03d1    5             hiz
03d2    7             ret

03d3    0
03d4              sendack:
03d4    6 0 8         outb 0x80
03d7    6 2 d         outb 0xd2
03da    3 3 0         out4 0x03
03dd    5             hiz
03de    7             ret

03df    0
03e0              sof:
03e0    9 0 c 6       be connerr
03e4    9 6 d f       bnf keep_alive
03e8    6 0 8         outb 0x80
03eb    6 5 a         outb 0xa5
03ee    6 0 0         outb 0x00
03f1    6 0 1         outb 0x10
03f4              keep_alive:
03f4    3 3 0         out4 0x03             ; low-speed keep-alive
03f7    5             hiz
03f8    7             ret

03f9    0 0 0
03fc              prgend:
