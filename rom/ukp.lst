0000              cstart:
; ---- start with high impedance
0000    5             hiz

; ---- set interrupt transfer interval
0001    f d           load 13
0003    0
0004              cstart2:
0004    e             wait
0005    9 1 5 6       bc connected
0009    9 0 1 0       be cstart2

; ---- wait 200ms after device attached
000d    c f 0         save 15 0             ; disconnected, reset watchdog
0010    1 8 c         ldi 200
0013    0
0014              w200ms:
0014    e             wait
0015    b             dec
0016    9 4 5 0       bnz w200ms

; ---- enumeration sequence
001a    8 f 6         call reset            ; reset device

; GET_DESCRIPTOR (Device, 0)
001d    e             wait
001e    8 9 f         call sof
0021    8 a d         call setup00
0024    8 7 7         call get_device
0027    8 6 d         call rcvdt
002a    1 0 8         ldi 128               ; receive 16 bytes of data from device
002d    2             start                 ; mark start of read transaction

; IN(0,0), ACK(), device descriptor
002e    0 0
0030              wait_get_device:
0030    e             wait
0031    8 9 f         call sof
0034    8 8 e         call in00
0037    8 7 d         call rcvdt2
003a    9 2 c 0       bnak wait_get_device
003e    8 6 f         call sendack
0041    9 4 c 0       bnz wait_get_device
; the buffer wraps, start reading from byte 8
0045    c 0 0         save 0 0              ; idVendor lsb
0048    c 1 1         save 1 1              ; idVendor msb
004b    c 2 2         save 2 2              ; idProduct lsb
004e    c 3 3         save 3 3              ; idProduct msb

; GET_DESCRIPTOR (Configuration, 0)
0051    e             wait
0052    8 9 f         call sof
0055    8 a d         call setup00
0058    8 2 8         call get_config
005b    8 6 d         call rcvdt
005e    1 0 9         ldi 144               ; receive up to 18 bytes of data from device
0061    2             start                 ; mark start of read transaction

; IN(0,0), ACK(), configuration descriptor
0062    0 0
0064              wait_get_config:
0064    e             wait
0065    8 9 f         call sof
0068    8 8 e         call in00
006b    8 7 d         call rcvdt2
006e    9 2 9 1       bnak wait_get_config
0072    8 6 f         call sendack
0075    9 4 9 1       bnz wait_get_config
; the buffer wraps, start reading from byte 14
0079    c 4 6         save 4 6               ; interface class
007c    c 5 7         save 5 7               ; interface sub-class
007f    c 6 0         save 6 0               ; interface protocol

; if the device is unsupported or DFU, go to start to make it timeout
0082    f e           load 14
0084    9 5 0 0       bz cstart

; ---- initialization sequence
0088    8 f 6         call reset            ; reset device again

; SET_ADDRESS (0, 1)
008b    e             wait
008c    8 9 f         call sof
008f    8 a d         call setup00
0092    8 d 8         call set_address
0095    8 6 d         call rcvdt

; IN(0,0), ACK()
0098              wait_set_address:
0098    e             wait
0099    8 9 f         call sof
009c    8 8 e         call in00
009f    8 6 d         call rcvdt
00a2    9 2 6 2       bnak wait_set_address
00a6    8 6 f         call sendack

; SET_CONFIGURATION (1, 1)
00a9    e             wait
00aa    8 9 f         call sof
00ad    8 f d         call setup10
00b0    8 8 9         call set_config
00b3    8 6 d         call rcvdt

; IN(1,0), ACK()
00b6    0 0
00b8              wait_set_config:
00b8    e             wait
00b9    8 9 f         call sof
00bc    8 d e         call in10
00bf    8 6 d         call rcvdt
00c2    9 2 e 2       bnak wait_set_config
00c6    8 6 f         call sendack

; skip HID initialization for Xbox 360-compatbile controllers
00c9    f c           load 12
00cb    9 4 4 5       bnz xinput_init

; SET_IDLE (1, 0)
00cf    e             wait
00d0    8 9 f         call sof
00d3    8 f d         call setup10
00d6    8 3 a         call set_idle
00d9    8 6 d         call rcvdt

; IN(1,0), ACK()
00dc              wait_set_idle:
00dc    e             wait
00dd    8 9 f         call sof
00e0    8 d e         call in10
00e3    8 6 d         call rcvdt
00e6    9 3 d 3       bstall set_idle_ready
00ea    9 2 7 3       bnak wait_set_idle
00ee    8 6 f         call sendack
00f1    0 0 0
00f4              set_idle_ready:

; GET_DESCRIPTOR (HID, 1, 0)
00f4    e             wait
00f5    8 9 f         call sof
00f8    8 f d         call setup10
00fb    8 9 b         call get_hid_report
00fe    8 6 d         call rcvdt
0101    1 8 4         ldi 72                ; receive 9 bytes of data from device
0104    2             start                 ; mark start of read transaction

; IN(1,0), ACK() - read but ignore contents
0105    0 0 0
0108              wait_get_hid_report:
0108    e             wait
0109    8 9 f         call sof
010c    8 d e         call in10
010f    8 7 d         call rcvdt2
0112    9 3 9 4       bstall get_hid_report_ready
0116    9 2 2 4       bnak wait_get_hid_report
011a    8 6 f         call sendack
011d    9 4 2 4       bnz wait_get_hid_report
0121    0 0 0
0124              get_hid_report_ready:

; SET_PROTOCOL (1, 0)
0124    e             wait
0125    8 9 f         call sof
0128    8 f d         call setup10
012b    8 e a         call set_protocol
012e    8 6 d         call rcvdt

; IN(1,0), ACK()
0131    0 0 0
0134              wait_set_protocol:
0134    e             wait
0135    8 9 f         call sof
0138    8 d e         call in10
013b    8 6 d         call rcvdt
013e    9 3 3 5       bstall set_protocol_ready
0142    9 2 d 4       bnak wait_set_protocol
0146    8 6 f         call sendack
0149    0 0 0
014c              set_protocol_ready:
014c    9 7 3 6       bjmp init_finished

0150              xinput_init:
; huge thanks to Jakob
; ref: https://jakob.space/blog/sorry-guys-i-have-to-troubleshoot-my-usb-drivers-before-i-can-play.html
; XINPUT_LED (1)
0150    e             wait
0151    8 9 f         call sof
0154    8 4 e         call out1x
0157    8 4 c         call xinput_led
015a    8 6 d         call rcvdt

; some third-party controllers Xbox 360-style controllers
; require this message to finish initialization
; ref: linux/drivers/input/joystick/xpad.c
; XINPUT_INIT (1)
015d    e             wait
015e    8 9 f         call sof
0161    8 f d         call setup10
0164    8 b c         call xinput_magic
0167    8 6 d         call rcvdt
016a    1 0 a         ldi 160               ; receive 20 bytes of data from device
016d    2             start                 ; mark start of read transaction

; IN(1,0), ACK() - read but ignore contents
016e    0 0
0170              wait_xinput_magic:
0170    e             wait
0171    8 9 f         call sof
0174    8 d e         call in10
0177    8 7 d         call rcvdt2
017a    9 3 3 6       bstall xinput_magic_ready
017e    9 2 c 5       bnak wait_xinput_magic
0182    8 6 f         call sendack
0185    9 4 c 5       bnz wait_xinput_magic
0189    0 0 0
018c              xinput_magic_ready:

; ---- initialization finished
018c              init_finished:
018c    c f 1         save 15 1             ; connected
018f    9 7 0 0       bjmp cstart

; ---- interrupt polling
0193    0
0194              connected:
0194    8 9 f         call sof
0197    b             dec
0198    9 4 1 0       bnz cstart2
019c    2             start                 ; mark start of read transaction
019d    8 2 f         call in1x
01a0    1 0 8         ldi 128               ; receive up to 16 bytes of HID report
01a3    8 7 d         call rcvdt2
01a6    9 2 0 0       bnak cstart
01aa    8 6 f         call sendack
01ad    9 7 0 0       bjmp cstart

; ---- disconnect and jump start
01b1    0 0 0
01b4              connerr:
01b4    c f 0         save 15 0             ; disconnected
01b7    9 7 0 0       bjmp cstart

; ---- subroutines
01bb    0
01bc              reset:
01bc    3 0 0         out4 0x00

; ---- wait 20ms
01bf    1 4 1         ldi 20
01c2    0 0
01c4              loop_reset:
01c4    e             wait
01c5    b             dec
01c6    9 4 1 7       bnz loop_reset
01ca    5             hiz

; ---- wait 40ms
01cb    1 8 2         ldi 40
01ce    0 0
01d0              w40ms:
01d0    e             wait
01d1    8 9 f         call sof
01d4    b             dec
01d5    9 4 4 7       bnz w40ms
01d9    7             ret

01da    0 0
01dc              get_device:               ; get device descriptor of (0,0)  get device descriptor of (0,0)
01dc    6 0 8         outb 0x80             ; SYNC
01df    6 3 c         outb 0xc3             ; PID=DATA0
01e2    6 0 8         outb 0x80             ; bmRequestType=80
01e5    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
01e8    6 0 0         outb 0x00             ; Desc Index=0
01eb    6 1 0         outb 0x01             ; Desc Type=1 (device)
01ee    6 0 0         outb 0x00             ; Language ID=0
01f1    6 0 0         outb 0x00             ;
01f4    6 0 1         outb 0x10             ; wLength=16
01f7    6 0 0         outb 0x00
01fa    6 1 e         outb 0xe1             ; CRC16
01fd    6 4 9         outb 0x94
0200    3 3 0         out4 0x03             ; EOP
0203    5             hiz
0204    7             ret

0205    0 0 0
0208              get_config:               ; get config descriptor of (0,0)  get config descriptor of (0,0)
0208    6 0 8         outb 0x80             ; SYNC
020b    6 3 c         outb 0xc3             ; PID=DATA0
020e    6 0 8         outb 0x80             ; bmRequestType=0
0211    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
0214    6 0 0         outb 0x00             ; Desc Index=0
0217    6 2 0         outb 0x02             ; Desc Type=2 (configuration)
021a    6 0 0         outb 0x00             ; Language ID=0
021d    6 0 0         outb 0x00             ;
0220    6 2 1         outb 0x12             ; wLength=18
0223    6 0 0         outb 0x00
0226    6 4 a         outb 0xa4             ; CRC16
0229    6 4 f         outb 0xf4
022c    3 3 0         out4 0x03             ; EOP
022f    5             hiz
0230    7             ret

0231    0 0 0
0234              set_address:              ; set address of device 0 to 1  set address of device 0 to 1
0234    6 0 8         outb 0x80
0237    6 3 c         outb 0xc3
023a    6 0 0         outb 0x00
023d    6 5 0         outb 0x05
0240    6 1 0         outb 0x01
0243    6 0 0         outb 0x00
0246    6 0 0         outb 0x00
0249    6 0 0         outb 0x00
024c    6 0 0         outb 0x00
024f    6 0 0         outb 0x00
0252    6 b e         outb 0xeb
0255    6 5 2         outb 0x25
0258    3 3 0         out4 0x03
025b    5             hiz
025c    7             ret

025d    0 0 0
0260              set_config:               ; set active configuration of device 1 to 1 (default config)  set active configuration of device 1 to 1 (default config)
0260    6 0 8         outb 0x80
0263    6 3 c         outb 0xc3
0266    6 0 0         outb 0x00
0269    6 9 0         outb 0x09
026c    6 1 0         outb 0x01
026f    6 0 0         outb 0x00
0272    6 0 0         outb 0x00
0275    6 0 0         outb 0x00
0278    6 0 0         outb 0x00
027b    6 0 0         outb 0x00
027e    6 7 2         outb 0x27
0281    6 5 2         outb 0x25
0284    3 3 0         out4 0x03
0287    5             hiz
0288    7             ret

0289    0 0 0
028c              set_idle:
028c    6 0 8         outb 0x80             ; SYNC
028f    6 3 c         outb 0xc3             ; PID=DATA0
0292    6 1 2         outb 0x21             ; bmRequestType=21
0295    6 a 0         outb 0x0a             ; bRequest=a (Set_Idle)
0298    6 0 0         outb 0x00             ; wValue=0
029b    6 0 0         outb 0x00
029e    6 0 0         outb 0x00             ; wIndex=0
02a1    6 0 0         outb 0x00
02a4    6 0 0         outb 0x00             ; wLength=0
02a7    6 0 0         outb 0x00
02aa    6 6 d         outb 0xd6             ; CRC16
02ad    6 0 2         outb 0x20
02b0    3 3 0         out4 0x03             ; EOP
02b3    5             hiz
02b4    7             ret

02b5    0 0 0
02b8              set_protocol:
02b8    6 0 8         outb 0x80             ; SYNC
02bb    6 3 c         outb 0xc3             ; PID=DATA0
02be    6 1 2         outb 0x21             ; bmRequestType=21
02c1    6 b 0         outb 0x0b             ; bRequest=b (Set_Protocol)
02c4    6 0 0         outb 0x00             ; wValue=0
02c7    6 0 0         outb 0x00
02ca    6 0 0         outb 0x00             ; wIndex=0
02cd    6 0 0         outb 0x00
02d0    6 0 0         outb 0x00             ; wLength=0
02d3    6 0 0         outb 0x00
02d6    6 6 c         outb 0xc6             ; CRC16
02d9    6 0 e         outb 0xe0
02dc    3 3 0         out4 0x03             ; EOP
02df    5             hiz
02e0    7             ret

02e1    0 0 0
02e4              get_hid_report:
02e4    6 0 8         outb 0x80             ; SYNC
02e7    6 3 c         outb 0xc3             ; PID=DATA0
02ea    6 1 8         outb 0x81             ; bmRequestType=81
02ed    6 6 0         outb 0x06             ; bRequest=6 (Get_Descriptor)
02f0    6 0 0         outb 0x00             ; Desc Index=0
02f3    6 2 2         outb 0x22             ; Desc Type=22 HID
02f6    6 0 0         outb 0x00             ; wInterfaceNumber=0
02f9    6 0 0         outb 0x00
02fc    6 9 0         outb 0x09             ; wLength=9
02ff    6 0 0         outb 0x00
0302    6 e e         outb 0xee             ; CRC16
0305    6 f 0         outb 0x0f
0308    3 3 0         out4 0x03             ; EOP
030b    5             hiz
030c    7             ret

030d    0 0 0
0310              xinput_led:
0310    6 0 8         outb 0x80             ; SYNC
0313    6 3 c         outb 0xc3             ; PID=DATA0
0316    6 1 0         outb 0x01
0319    6 3 0         outb 0x03
031c    6 2 0         outb 0x02
031f    6 e 5         outb 0x5e             ; CRC16
0322    6 e c         outb 0xce
0325    3 3 0         out4 0x03             ; EOP
0328    5             hiz
0329    7             ret

032a    0 0
032c              xinput_magic:
032c    6 0 8         outb 0x80             ; SYNC
032f    6 3 c         outb 0xc3             ; PID=DATA0
0332    6 1 c         outb 0xc1             ; bmRequestType=c1
0335    6 1 0         outb 0x01             ; bRequest=1
0338    6 0 0         outb 0x00             ; wValue=0x0100
033b    6 1 0         outb 0x01
033e    6 0 0         outb 0x00             ; wIndex=0x0000
0341    6 0 0         outb 0x00
0344    6 4 1         outb 0x14             ; wLength=20
0347    6 0 0         outb 0x00
034a    6 0 5         outb 0x50             ; CRC16
034d    6 8 6         outb 0x68
0350    3 3 0         out4 0x03             ; EOP
0353    5             hiz
0354    7             ret

0355    0 0 0
0358              rcvdt:
0358    1 0 4         ldi 64                ; receive up to 8 bytes of data from device by default
035b    0
035c              rcvdt2:
035c    d             in
035d    0 0 0
0360              rcvdt_eop:
0360    5             hiz
0361    9 0 8 d       be rcvdt_eop          ; wait for line idle
0365    5             hiz                   ; ensure delay before next transaction
0366    7             ret

0367    0
0368              setup00:
0368    6 0 8         outb 0x80             ; SYNC
036b    6 d 2         outb 0x2d             ; PID
036e    6 0 0         outb 0x00             ; ADDR:ENDP=0:0
0371    6 0 1         outb 0x10             ; + CRC5
0374    3 3 0         out4 0x03             ; EOP
0377    5             hiz
0378    7             ret

0379    0 0 0
037c              setup10:
037c    6 0 8         outb 0x80             ; SYNC
037f    6 d 2         outb 0x2d             ; PID
0382    6 1 0         outb 0x01             ; ADDR:ENDP=1:0
0385    6 8 e         outb 0xe8             ; + CRC5
0388    3 3 0         out4 0x03             ; EOP
038b    5             hiz
038c    7             ret

038d    0 0 0
0390              out1x:
0390    6 0 8         outb 0x80             ; SYNC
0393    6 1 e         outb 0xe1             ; PID=OUT
0396    a a           outr 10               ; ADDR:ENDP
0398    a b           outr 11               ; + CRC5
039a    3 3 0         out4 0x03             ; EOP
039d    5             hiz
039e    7             ret

039f    0
03a0              in00:
03a0    6 0 8         outb 0x80             ; SYNC
03a3    6 9 6         outb 0x69             ; PID=IN
03a6    6 0 0         outb 0x00             ; ADDR:ENDP=0:0
03a9    6 0 1         outb 0x10             ; + CRC5
03ac    3 3 0         out4 0x03             ; EOP
03af    5             hiz
03b0    7             ret

03b1    0 0 0
03b4              in10:
03b4    6 0 8         outb 0x80             ; SYNC
03b7    6 9 6         outb 0x69             ; PID=IN
03ba    6 1 0         outb 0x01             ; ADDR:ENDP=1:0
03bd    6 8 e         outb 0xe8             ; + CRC5
03c0    3 3 0         out4 0x03             ; EOP
03c3    5             hiz
03c4    7             ret

03c5    0 0 0
03c8              in1x:
03c8    6 0 8         outb 0x80             ; SYNC
03cb    6 9 6         outb 0x69             ; PID=IN
03ce    a 8           outr 8                ; ADDR:ENDP
03d0    a 9           outr 9                ; + CRC5
03d2    3 3 0         out4 0x03             ; EOP
03d5    5             hiz
03d6    7             ret

03d7    0
03d8              sendack:
03d8    6 0 8         outb 0x80
03db    6 2 d         outb 0xd2
03de    3 3 0         out4 0x03
03e1    5             hiz
03e2    7             ret

03e3    0
03e4              sof:
03e4    9 0 d 6       be connerr
03e8    9 6 e f       bnf keep_alive
03ec    6 0 8         outb 0x80
03ef    6 5 a         outb 0xa5
03f2    6 0 0         outb 0x00
03f5    6 0 1         outb 0x10
03f8              keep_alive:
03f8    3 3 0         out4 0x03             ; low-speed keep-alive
03fb    5             hiz
03fc    7             ret

03fd    0 0 0
0400              prgend:
